<section class="cta-band">
  <div class="wrap cta-band-inner">
    <svg class="cta-heart" viewBox="0 0 64 64" aria-hidden="true">
      <path d="M32 52S9 37 9 21.5C9 13.9 15 8 22.5 8c3.9 0 7.4 1.9 9.5 5 2.1-3.1 5.6-5 9.5-5C49 8 55 13.9 55 21.5 55 37 32 52 32 52z" fill="none" stroke="currentColor" stroke-width="2"/>
    </svg>
    <h2>A Kind Path to Better Care</h2>
    <p>Every family's path looks different. Tell us where yours needs to go, and we'll help you find the way &mdash; no pressure, just a conversation.</p>
    <div class="cta-actions">
      <a href="<%= business.phoneHref %>" class="btn btn-gold">Call Us Now</a>
      <a href="/contact" class="btn btn-outline-light">Send a Message</a>
    </div>
  </div>
</section>

<footer class="site-footer">
  <div class="wrap footer-grid">
    <div class="footer-brand">
      <span class="brand-script footer-script">Kind Path</span>
      <span class="brand-sub footer-sub">Care Services</span>
      <p class="footer-tagline"><%= business.tagline %></p>
    </div>

    <div class="footer-col">
      <h4>Contact</h4>
      <a href="<%= business.phoneHref %>"><svg class="i i-sm"><use href="#icon-phone"/></svg><%= business.phone %></a>
      <a href="mailto:<%= business.email %>"><svg class="i i-sm"><use href="#icon-mail"/></svg><%= business.email %></a>
      <span class="footer-address"><svg class="i i-sm"><use href="#icon-pin"/></svg>
        <span><% business.address.forEach(function(line){ %><%= line %><br><% }) %></span>
      </span>
      <a href="/"><svg class="i i-sm"><use href="#icon-globe"/></svg><%= business.website %></a>
    </div>

    <div class="footer-col">
      <h4>Services</h4>
      <% business.services.forEach(function(s){ %>
        <a href="/services"><%= s.title %></a>
      <% }) %>
    </div>

    <div class="footer-col">
      <h4>Company</h4>
      <a href="/about">About Us</a>
      <a href="/services">Our Services</a>
      <a href="/contact">Contact Us</a>
    </div>
  </div>

  <div class="wrap footer-bottom">
    <p>&copy; <%= new Date().getFullYear() %> <%= business.name %>. All rights reserved.</p>
    <p class="footer-motto">"<%= business.motto %>"</p>
  </div>
</footer>
